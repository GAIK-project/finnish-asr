# Keys for the scripts that call APIs. Copy to .env at the repo root (gitignored) and fill in only
# what you need; a script skips an arm or judge whose keys are missing. Names only, never values.

# run_api_asr.py: ElevenLabs Scribe v2
ELEVENLABS_API_KEY=
# run_api_asr.py (Google Chirp 3) and judge_asr.py (Gemini 3.1 Pro judge): Google Cloud / Vertex AI
GOOGLE_VERTEXAI_PROJECT=
GOOGLE_VERTEXAI_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# judge_asr.py, judge_dialect.py, prepare_targets.py: Claude Opus 5.5 through Azure Foundry (as recorded)
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
# ... or through the Anthropic API (judge_asr.py --claude-provider api, judge_dialect.py and
# prepare_targets.py --provider api)
ANTHROPIC_API_KEY=

# judge_dialect.py --provider aitta: open models on CSC Aitta
AITTA_API_TOKEN=

# publish_hf.py (maintainers only): a token with write access to the GAIK-project organisation
HF_TOKEN=

# lumi/lumi.sh reads these from the shell, not from .env:
#   export LUMI_USER=<CSC user name> LUMI_PROJECT=project_<number>
